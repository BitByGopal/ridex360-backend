# Copy this file to .env and adjust as needed.
# Leave DATABASE_URL empty to use SQLite (default, zero setup).

SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# Uncomment and fill in to use PostgreSQL instead of SQLite:
# DATABASE_URL=postgres://user:password@host:5432/ridex360

CORS_ALLOW_ALL_ORIGINS=True
